# Local Postgres user for docker compose.
POSTGRES_USER=app

# Local Postgres password for docker compose.
POSTGRES_PASSWORD=app_secret

# Local Postgres database for docker compose.
POSTGRES_DB=app

# Host port mapped to backend container port 8080.
BACKEND_PORT=8080

# Host port mapped to frontend container port 3000.
FRONTEND_PORT=3000

# Browser-visible backend base URL for frontend builds.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional backend memory limit.
BACKEND_MEM_LIMIT=768m

# Optional frontend memory limit.
FRONTEND_MEM_LIMIT=768m

# Optional Postgres memory limit.
POSTGRES_MEM_LIMIT=512m
